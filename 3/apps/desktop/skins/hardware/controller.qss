    border-left: 1px solid #667276;
    border-right: 1px solid #242c2f;
    border-bottom: 1px solid #1c2123;
    border-radius: 3px;
    font-weight: 600;
}

QPushButton#programItemFadeInButton,
QPushButton#programItemFadeOutButton,
QPushButton#programMasterFadeInButton,
QPushButton#programMasterFadeOutButton,
QPushButton#programItemEqButton,
QPushButton#programMasterEqButton,
QPushButton#editNominalEqButton {
    padding: 1px 4px;
}

QPushButton#offAirButton:hover,
QPushButton#ftbButton:hover,
QPushButton#dskOnButton:hover,
QPushButton#dskPlayButton:hover,
QPushButton#dskPauseButton:hover,
QPushButton#programPauseButton:hover,
QPushButton#programPlayButton:hover,
QPushButton#powerPointPreviousButton:hover,
QPushButton#powerPointNextButton:hover,
QPushButton[playbackRateButton="true"]:hover,
QPushButton[bgmTransportButton="true"]:hover,
QPushButton[operatorTimerButton="true"]:hover,
