QWidget#controllerWindow,
QDialog#operatorTimerSettingsDialog,
QDialog#programMasterEqWindow,
QDialog[itemEqWindow="true"] {
    background-color: #3d4143;
}

QDialog#operatorTimerSettingsDialog QLabel,
QDialog#programMasterEqWindow QLabel,
QDialog[itemEqWindow="true"] QLabel {
    color: #e4e7e8;
    background: transparent;
}

QDialog#operatorTimerSettingsDialog QLabel,
QDialog#operatorTimerSettingsDialog QLineEdit,
QDialog#operatorTimerSettingsDialog QSpinBox,
QDialog#operatorTimerSettingsDialog QPushButton {
    font-size: 12px;
}

QDialog#operatorTimerSettingsDialog QPushButton {
    min-height: 22px;
    padding: 4px 12px;
}

QDialog#operatorTimerSettingsDialog QSpinBox,
QLineEdit#operatorMonitorCueInput {
    min-height: 22px;
}

QWidget#controllerWoodTrim {
    background-color: #573820;
    background-image: url(:/vtrpon/apps/desktop/skins/hardware/controller_walnut_trim.svg);
    background-repeat: repeat-x;
    background-position: center left;
    border-top: 1px solid #8c6845;
    border-bottom: 1px solid #21130b;
}

QWidget#systemLoadWidget QLabel {
    color: #f0e8df;
    background: transparent;
    border: none;
    padding: 0;
}

QWidget#systemLoadWidget QLabel[loadWarning="true"] {
    color: #ffaaaa;
}

QMenuBar#applicationMenuBar {
    background-color: #573820;
    background-image: url(:/vtrpon/apps/desktop/skins/hardware/controller_walnut_trim.svg);
    background-repeat: repeat-x;
    background-position: center left;
    color: #f0e8df;
    border-top: 1px solid #8c6845;
    border-bottom: 1px solid #21130b;
    padding: 2px 4px;
}

QMenuBar#applicationMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar#applicationMenuBar::item:selected,
QMenuBar#applicationMenuBar::item:pressed {
    background: #2e1c12;
    color: #ffffff;
}

QMenu#fileMenu {
    background: #17191b;
    color: #e4e7e8;
    border: 1px solid #464c50;
    padding: 4px 0;
}

QMenu#fileMenu::item {
    padding: 6px 30px 6px 12px;
}

QMenu#fileMenu::item:selected {
    background: #2e7d32;
    color: #ffffff;
}

QWidget#editControlPanel,
QWidget#programControlPanel,
QWidget#playlistPanel,
QWidget#inputControlPanel {
    background-color: #111d21;
    border-top: 2px solid #5d777b;
    border-left: 2px solid #455f63;
    border-right: 2px solid #183027;
    border-bottom: 2px solid #173622;
    border-radius: 5px;
}

QWidget#editNominalVolumeStrip,
QWidget#programMasterAudioStrip {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #243b42, stop:0.5 #142328,
                                stop:1 #080d10);
    border-top: 2px solid #6b8085;
    border-left: 2px solid #4f666b;
    border-right: 2px solid #111a1e;
    border-bottom: 2px solid #080d0f;
    border-radius: 4px;
}

QLabel#editSectionTitle,
QLabel#playlistTitle,
QLabel#programSectionTitle,
QLabel#inputControlTitle {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #343b3e, stop:1 #1b2123);
    font-family: "Arial";
    font-size: 9px;
    font-weight: 500;
    border: 1px solid #596164;
    border-radius: 3px;
    padding: 1px 6px;
}

QLabel#editSectionTitle {
    color: #abb7ad;
}

QLabel#playlistTitle {
    color: #c4c1b8;
}

QLabel#programSectionTitle {
    color: #c2a5a6;
}

QLabel#inputControlTitle {
    color: #c8cdcf;
}

QWidget#editMonitor,
QWidget#onAirMonitor {
    background: #000000;
    border: 1px solid #454b4e;
}

QWidget#editMonitor {
    background: #010304;
    border-top: 3px solid #829397;
    border-left: 3px solid #6d7e83;
    border-right: 3px solid #182126;
    border-bottom: 3px solid #0b1013;
}

QWidget#onAirMonitor {
    background: #010304;
    border-top: 3px solid #839499;
    border-left: 3px solid #6e8086;
    border-right: 3px solid #182126;
    border-bottom: 3px solid #0b1013;
}

QWidget#programVideoWindow {
    background: #000000;
}

QPushButton {
    background: #2a2e31;
    color: #e4e7e8;
    border: 1px solid #464c50;
    border-radius: 4px;
    padding: 1px 8px;
    font-size: 9px;
    font-weight: 500;
}

QPushButton:hover {
    background: #353a3e;
    border-color: #667076;
}

QPushButton:pressed {
    background: #202427;
    border-color: #747e84;
}

QPushButton:focus {
    border: 2px solid #90caf9;
}

QPushButton[active="true"],
QPushButton:checked {
    background: #2e7d32;
    color: #ffffff;
    border: 1px solid #4ba957;
    font-weight: 600;
}

QPushButton[active="true"]:hover,
QPushButton:checked:hover {
    background: #388e3c;
    border-color: #66bb6a;
}

QPushButton[active="true"]:pressed,
QPushButton:checked:pressed {
    background: #256829;
    border-color: #3d8d46;
}

QPushButton:disabled,
QPushButton[active="true"]:disabled,
QPushButton:checked:disabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3c4448, stop:0.16 #323a3e,
                                stop:0.82 #252c2f, stop:1 #1d2225);
    color: #818b8e;
    border-top: 1px solid #4c565a;
    border-left: 1px solid #434c50;
    border-right: 1px solid #1f2629;
    border-bottom: 1px solid #181d1f;
    font-weight: 500;
}

QLabel#operatorTimerTitle,
QLabel#editControlModuleTitle,
QLabel#inputControlModuleTitle,
QLabel#programControlModuleTitle {
    background: transparent;
    color: #dbe4e0;
    font-size: 9px;
    font-weight: bold;
    border: none;
}

QPushButton[remainingModeButton="true"] {
    color: #c4cecb;
    background: #232a2d;
    border: 1px solid #667378;
    border-radius: 3px;
    padding: 0 4px;
    font-size: 9px;
    font-weight: bold;
}

QPushButton[remainingModeButton="true"]:hover {
    color: #ffffff;
    border-color: #879397;
}

QPushButton[remainingModeButton="true"]:checked {
    color: #fff0c2;
    background: #4a4030;
    border-color: #a89262;
}

QPushButton[remainingModeButton="true"]:focus {
    border: 2px solid #90caf9;
}

QLabel#programBgmItemLabel {
    color: #dbe4e0;
    background: transparent;
    border: none;
    font-size: 9px;
}

QLabel#programBgmSignalIndicator {
    color: #818b8e;
    background: #101518;
    border: 1px solid #495256;
    border-radius: 3px;
    font-size: 8px;
    font-weight: bold;
}

QLabel#programBgmSignalIndicator[active="true"] {
    color: #101510;
    background: #78c86f;
    border-color: #a3dfa0;
}

QLabel#programBgmSignalIndicator[clipped="true"] {
    color: #ffffff;
    background: #c83d35;
    border-color: #ff8d86;
}

QPushButton[bgmTransportButton="true"] {
    padding: 1px 5px;
    font-size: 9px;
}

QCheckBox#editFadeInCheckBox,
QCheckBox#editFadeOutCheckBox,
QCheckBox#editEndCrossfadeCheckBox,
QLabel#editGotoTargetLabel,
QLabel#stillCaptureDurationLabel,
QLabel#editRepeatOptionLabel,
QLabel#editRepeatCountLabel,
QLabel#editRepeatEndModeLabel,
QDoubleSpinBox[fadeDurationSpinBox="true"],
QSpinBox[audioDelayControl="true"],
QDoubleSpinBox#editFadeInDurationSpinBox,
QDoubleSpinBox#editFadeOutDurationSpinBox,
QDoubleSpinBox#editEndCrossfadeDurationSpinBox,
QDoubleSpinBox#playlistCrossfadeDurationSpinBox {
    font-size: 9px;
}

QCheckBox#editFadeInCheckBox,
QCheckBox#editFadeOutCheckBox,
QCheckBox#editEndCrossfadeCheckBox {
    color: #cbd5d2;
    spacing: 4px;
}

QCheckBox#editFadeInCheckBox::indicator,
QCheckBox#editFadeOutCheckBox::indicator,
QCheckBox#editEndCrossfadeCheckBox::indicator {
    width: 14px;
    height: 14px;
    background: #080d0f;
    border-top: 1px solid #111719;
    border-left: 1px solid #151d20;
    border-right: 1px solid #738085;
    border-bottom: 1px solid #849095;
    border-radius: 2px;
}

QCheckBox#editFadeInCheckBox::indicator:checked,
QCheckBox#editFadeOutCheckBox::indicator:checked,
QCheckBox#editEndCrossfadeCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #69c577, stop:0.35 #3b904c,
                                stop:1 #174626);
    border-color: #8adb94;
}

QDoubleSpinBox[fadeDurationSpinBox="true"],
QSpinBox[audioDelayControl="true"],
QDoubleSpinBox#editFadeInDurationSpinBox,
QDoubleSpinBox#editFadeOutDurationSpinBox,
QDoubleSpinBox#editEndCrossfadeDurationSpinBox,
QDoubleSpinBox#playlistCrossfadeDurationSpinBox,
QDialog#operatorTimerSettingsDialog QSpinBox,
QLineEdit#operatorMonitorCueInput,
QSpinBox#editRepeatCountSpinBox,
QComboBox#editGotoTargetComboBox,
QComboBox#editRepeatEndModeComboBox,
QComboBox#inputUvcDeviceComboBox,
QComboBox#playlistBulkOperationComboBox {
    background: #071012;
    color: #e2e9e6;
    border-top: 1px solid #080c0e;
    border-left: 1px solid #0c1214;
    border-right: 1px solid #657378;
    border-bottom: 1px solid #78868a;
    border-radius: 2px;
    padding: 1px 5px;
    selection-background-color: #2f7540;
}

QDoubleSpinBox[fadeDurationSpinBox="true"],
QSpinBox[audioDelayControl="true"],
QDoubleSpinBox#editFadeInDurationSpinBox,
QDoubleSpinBox#editFadeOutDurationSpinBox,
QDoubleSpinBox#editEndCrossfadeDurationSpinBox,
QDoubleSpinBox#playlistCrossfadeDurationSpinBox,
QDialog#operatorTimerSettingsDialog QSpinBox,
QLineEdit#operatorMonitorCueInput,
QSpinBox#editRepeatCountSpinBox {
    padding-left: 3px;
    padding-right: 3px;
}

QDoubleSpinBox[fadeDurationSpinBox="true"],
QSpinBox[audioDelayControl="true"],
QDoubleSpinBox#editFadeInDurationSpinBox,
QDoubleSpinBox#editFadeOutDurationSpinBox,
QDoubleSpinBox#editEndCrossfadeDurationSpinBox,
QDoubleSpinBox#playlistCrossfadeDurationSpinBox,
